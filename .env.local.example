# ==========================================
# NYALA AI COMPANION CONFIGURATION
# ==========================================

# Opsi 1: Google Gemini API (Sangat Direkomendasikan - Gratis & Cepat)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opsi 2: Groq API (Alternatif Cepat & Gratis)
# Dapatkan API Key di: https://console.groq.com/keys
GROQ_API_KEY=

# Opsi 3: OpenRouter API
# Dapatkan API Key di: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Catatan: Jika API Key tidak diisi, Nyala AI tetap dapat berjalan
# dengan mode Smart Local Knowledge Engine untuk menjawab seputar MASTA UMKT 2026!
